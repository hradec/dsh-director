{
  "name": "dsh-director",
  "version": "0.2.158",
  "description": "Director tools, Assets, Production and Story sidebar tabs, decision/beat story bible with chronology lint, optional H3 guidance, and conversation media previews for DeepSeek Harness Web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai2764/dsh-director.git"
  },
  "homepage": "https://github.com/ai2764/dsh-director#readme",
  "bugs": {
    "url": "https://github.com/ai2764/dsh-director/issues"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.mjs",
    "lib/client.js",
    "lib/timeline-engine.js",
    "lib/previz-player.js",
    "skills/director",
    "skills/crew",
    "skills/h3-prompt-writing/SKILL.md",
    "skills/h3-prompt-writing/references/UPSTREAM.md",
    "cordis.patch.yml",
    "README.md",
    "docs/CONFIGURATION.md",
    "docs/RELEASE_REVIEW.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "docs/TIMELINE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretest": "node scripts/build.mjs",
    "test": "node --test src/*.test.mjs test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@tailwindcss/cli": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.9.1",
    "i18next-browser-languagedetector": "^8.3.1",
    "immer": "^11.2.10",
    "lucide-react": "^1.77.0",
    "mediabunny": "^1.66.2",
    "pinyin-pro": "^3.29.5",
    "pixi.js": "^8.23.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yaml": "^2.8.0"
  }
}
